digraph context_control_lifecycle {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.28", nodesep="0.28", ranksep="0.48", splines=polyline, fontname="Arial, PingFang SC, Microsoft YaHei"];
  node [shape=box, style="rounded,filled", color="#263238", penwidth=1.4, margin="0.16,0.11", fontname="Arial, PingFang SC, Microsoft YaHei", fontsize=10.5];
  edge [color="#455a64", penwidth=1.4, arrowsize=0.75, fontname="Arial, PingFang SC, Microsoft YaHei", fontsize=8.5, fontcolor="#263238"];

  sources [label="上下文来源\n历史、system、memory、tools", fillcolor="#fff3cd"];
  assemble [label="请求装配\n规范化与分段", fillcolor="#e3f2fd"];
  reuse [label="复用与延迟\nprompt cache / Tool Search", fillcolor="#c8e6c9"];
  trim [label="局部治理\ncontext hint / microcompact", fillcolor="#ffe0b2"];
  compact [label="全局治理\nsummary + preserved suffix", fillcolor="#d1c4e9"];
  boundary [label="恢复关系\ncompact boundary / transcript", fillcolor="#d7ccc8"];
  next [label="下一次请求\n更短且因果合法", fillcolor="#b2dfdb"];

  sources -> assemble [label="汇入"];
  assemble -> reuse [label="标记稳定前缀"];
  reuse -> trim [label="窗口继续增长"];
  trim -> compact [label="仍接近有效上限"];
  compact -> boundary [label="持久化替代关系"];
  boundary -> next [label="重建有效消息视图"];
  next -> sources [label="新结果继续累积"];
}
