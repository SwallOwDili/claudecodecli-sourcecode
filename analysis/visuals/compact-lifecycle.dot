digraph compact_lifecycle {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.28",
    nodesep="0.34",
    ranksep="0.58",
    splines=polyline,
    fontname="Arial, PingFang SC, Microsoft YaHei"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#263238",
    penwidth=1.4,
    margin="0.16,0.11",
    fontname="Arial, PingFang SC, Microsoft YaHei",
    fontsize=12
  ];
  edge [
    color="#455a64",
    penwidth=1.4,
    arrowsize=0.75,
    fontname="Arial, PingFang SC, Microsoft YaHei",
    fontsize=10,
    fontcolor="#263238"
  ];

  trigger [label="用户执行 /compact\nPreCompact 放行", fillcolor="#fff3cd"];
  groups [label="按合法消息组切分\n较早前缀 / 近期后缀", fillcolor="#bbdefb"];
  summarize [label="模型写工程交接 Summary\n禁止工具，只返回文本", fillcolor="#d1c4e9"];
  parse [label="客户端解析\n标签匹配时删 analysis，留 summary", fillcolor="#d1c4e9"];
  rebuild [label="重建短工作包\nSummary + 近期因果 + 精确附件", fillcolor="#c8e6c9"];
  boundary [label="写 compact boundary\n记录 token 与保留 UUID", fillcolor="#d7ccc8"];
  next [label="下一次模型请求\n从短历史继续任务", fillcolor="#b2dfdb"];
  trigger -> groups [label="普通 miss：选择范围"];
  groups -> summarize [label="总结较早合法前缀"];
  summarize -> parse [label="返回交接文本"];
  parse -> rebuild [label="提供远期语义"];
  groups -> rebuild [label="保留近期完整因果"];
  rebuild -> boundary [label="持久化表示切换"];
  boundary -> next [label="采用新的逻辑历史"];
}
