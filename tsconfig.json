{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false
  },
  "include": [
    "site/labs/src/**/*.ts",
    "site/labs/tests/**/*.ts",
    "vite.config.ts"
  ]
}
