digraph telemetry_pipeline {
  graph [rankdir=TB, bgcolor="#ffffff", pad="0.28", nodesep="0.27", ranksep="0.48", splines=polyline, fontname="Arial, PingFang SC, Microsoft YaHei"];
  node [shape=box, style="rounded,filled", color="#263238", penwidth=1.4, margin="0.15,0.10", fontname="Arial, PingFang SC, Microsoft YaHei", fontsize=10.5];
  edge [color="#455a64", penwidth=1.4, arrowsize=0.75, fontname="Arial, PingFang SC, Microsoft YaHei", fontsize=8.5, fontcolor="#263238"];

  events [label="运行时信号\nquery / model / tool / permission / compact / error", fillcolor="#fff3cd"];
  enrich [label="关联与归一化\nIDs、token、cost、latency、environment", fillcolor="#e3f2fd"];
  privacy [label="门控与内容控制\nprovider、policy、DNT、redaction、sampling", fillcolor="#ffe0b2"];
  first [label="一方流水线\nqueue -> batch -> retry/persist", fillcolor="#d1c4e9"];
  otel [label="用户配置 OTEL\nmetrics / logs / traces exporters", fillcolor="#c8e6c9"];
  local [label="本地诊断\ndebug / Perfetto / profile / stderr", fillcolor="#d7ccc8"];
  diagnose [label="可回答的问题\n慢在哪、为何重试、何时拒绝、花费多少", fillcolor="#b2dfdb"];

  events -> enrich [label="生成结构化记录"];
  enrich -> privacy [label="应用字段与流量门"];
  privacy -> first [label="允许一方发送"];
  privacy -> otel [label="显式启用第三方出口"];
  privacy -> local [label="写本地诊断"];
  first -> diagnose [label="聚合分析"];
  otel -> diagnose [label="导出观测"];
  local -> diagnose [label="现场排障"];
}
