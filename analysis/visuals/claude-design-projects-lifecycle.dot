digraph ClaudeDesignProjectsLifecycle {
  graph [rankdir=TB, bgcolor="transparent", pad="0.20", nodesep="0.50", ranksep="0.68", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10.5, margin="0.14,0.10", color="#334155", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=9.2, color="#475569", penwidth=1.2, arrowsize=0.72];

  request [label="User request\nDesign artifact + durable project doc", fillcolor="#DBEAFE"];
  pipeline [label="Normal Agent tool pipeline\nvalidation + permission + paired result", fillcolor="#EDE9FE"];
  design [label="ClaudeDesign lane\ninitialize + dynamic tools/list\nPermission decision + persistent writes", fillcolor="#CCFBF1"];
  projects [label="Projects: attached project\nfixed five-method dispatcher + Write path\ncompleted writes persist", fillcolor="#FEF3C7"];
  paired [label="Bounded tool_result\npaired by tool_use_id", fillcolor="#DCFCE7"];
  next [label="Next model iteration\ncontinues with observed state\nExternal state persists separately", fillcolor="#DBEAFE"];

  request -> pipeline [label="enters shared pipeline"];
  pipeline -> design [label="routes visual collaboration"];
  pipeline -> projects [label="routes attached knowledge"];
  design -> paired [label="returns bounded MCP result"];
  projects -> paired [label="returns bounded Project result"];
  paired -> next [label="feeds next iteration"];

  { rank=same; design; projects; }
}
