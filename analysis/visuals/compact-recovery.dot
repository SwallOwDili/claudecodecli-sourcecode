digraph compact_recovery {
  graph [
    rankdir=TB,
    bgcolor="#ffffff",
    pad="0.28",
    nodesep="0.38",
    ranksep="0.58",
    splines=polyline,
    fontname="Arial, PingFang SC, Microsoft YaHei"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#263238",
    penwidth=1.35,
    margin="0.16,0.10",
    fontname="Arial, PingFang SC, Microsoft YaHei",
    fontsize=11
  ];
  edge [
    color="#455a64",
    penwidth=1.3,
    arrowsize=0.72,
    fontname="Arial, PingFang SC, Microsoft YaHei",
    fontsize=9.5,
    fontcolor="#263238"
  ];

  attempt [label="请求 Summary", fillcolor="#d1c4e9"];
  ptl [label="Summary 仍然超窗", fillcolor="#ffcdd2"];
  preserve [label="多保留尾部 group\n缩短待总结前缀", fillcolor="#fff3cd"];
  model [label="当前模型不可用", fillcolor="#ffcdd2"];
  fallback [label="切换允许的 fallback 模型", fillcolor="#fff3cd"];
  rebuild [label="Summary 成功\n开始重建短工作包", fillcolor="#c8e6c9"];
  attach [label="精确附件恢复失败", fillcolor="#ffcdd2"];
  degrade [label="记录错误\n使用可取得的较小附件集合", fillcolor="#fff3cd"];
  boundary [label="重建有效后写 Boundary\n否则原历史继续有效", fillcolor="#b2dfdb"];

  { rank=same; ptl; attempt; model; }
  { rank=same; preserve; fallback; }

  attempt -> rebuild [label="得到有效 Summary"];
  attempt -> ptl [label="token gap"];
  ptl -> preserve [label="调整范围"];
  preserve -> attempt [label="重试"];
  attempt -> model [label="fallback signal"];
  model -> fallback [label="策略允许"];
  fallback -> attempt [label="重试"];
  rebuild -> boundary [label="附件恢复成功"];
  rebuild -> attach [label="读取失败"];
  attach -> degrade [label="manual / reactive 降级"];
  degrade -> boundary [label="仍形成有效表示"];
}
